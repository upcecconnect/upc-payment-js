{
  "name": "upc-payment-js",
  "version": "2.0.0",
  "description": "upc-payment-js allows to initiate and process a payment in a separate browser tab or within an iframe directly on the website",
  "main": "./dist/umd/upc-payment-js.umd.cjs",
  "module": "./dist/es/upc-payment-js.js",
  "exports": {
    ".": {
      "require": "./dist/umd/upc-payment-js.umd.cjs",
      "import": "./dist/es/upc-payment-js.js"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "vite",
    "check-types": "tsc --noEmit",
    "build": "tsc && vite build --mode iife && vite build --mode es && vite build --mode umd"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/upcecconnect/upc-payment-js.git"
  },
  "homepage": "https://ecconnect.upc.ua",
  "keywords": [
    "upc",
    "eCommerce"
  ],
  "author": "UPC",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.2.1",
    "oxlint": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "files": [
    "dist/es",
    "dist/umd",
    "dist/iife"
  ]
}
